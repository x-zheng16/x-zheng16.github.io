#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

for tool in bundle uv; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    printf 'Missing %s on PATH. See INSTALL.md.\n' "$tool" >&2
    exit 1
  fi
done

export BUNDLE_FROZEN=true
export JEKYLL_ENV=development

port=${PORT:-4000}
printf 'Homepage preview: http://127.0.0.1:%s/\n' "$port"

exec uv run --python 3.13 --no-project --with-requirements requirements.txt -- bundle exec jekyll serve --host 127.0.0.1 --port "$port" --watch
