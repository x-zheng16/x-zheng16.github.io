#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

export PATH="/opt/homebrew/opt/ruby@3.3/bin:/opt/homebrew/lib/ruby/gems/3.3.0/bin:${PATH:-/usr/bin:/bin}"
export BUNDLE_FROZEN=true
export BUNDLE_PATH=vendor/bundle
export JEKYLL_ENV=development

port=${PORT:-4000}
printf 'Homepage preview: http://127.0.0.1:%s/\n' "$port"

exec /opt/homebrew/bin/uv run --python 3.13 --no-project --with-requirements requirements.txt -- bundle exec jekyll serve --host 127.0.0.1 --port "$port" --watch
