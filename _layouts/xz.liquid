<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="dark light">
    <meta name="theme-color" content="#1c1c1d" media="(prefers-color-scheme: dark)">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <script>
      (function () {
        var t = null;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
    <title>{% if page.permalink == '/' %}Xiang Zheng{% else %}{{ page.title }} · Xiang Zheng{% endif %}</title>
    <meta name="description" content="Xiang Zheng (郑翔), Research Assistant Professor at the Hong Kong Institute of AI for Science, City University of Hong Kong. Reinforcement learning for trustworthy science, computer-use and embodied agents.">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link rel="icon" href="data:,">
    <link rel="preload" href="{{ '/assets/fonts/source-serif-4-normal-latin.woff2' | relative_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ '/assets/css/xz.css' | relative_url | bust_file_cache }}">
    <script src="{{ '/assets/js/xz.js' | relative_url | bust_file_cache }}" defer></script>
  </head>
  <body>
    <div class="topnav">
      <div class="wrap">
        <nav class="navlinks" aria-label="Main">
          {%- assign nav = "/|About,/publications/|Publications,/students/|Students,/talks/|Talks,/news/|News" | split: "," -%}
          {%- for item in nav -%}
            {%- assign parts = item | split: "|" %}
          <a href="{{ parts[0] | relative_url }}"{% if page.url == parts[0] %} aria-current="page"{% endif %}>{{ parts[1] }}</a>
          {%- endfor %}
        </nav>
        <button class="themetoggle" type="button" aria-label="Switch between light and dark theme" title="Switch theme">
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
        </button>
      </div>
    </div>
    <main class="wrap">
{{ content }}
    </main>
    <footer class="foot">
      <div class="wrap">
        <span>Last updated {{ site.time | date: "%Y.%m.%d" }}</span>
      </div>
    </footer>
  </body>
</html>
