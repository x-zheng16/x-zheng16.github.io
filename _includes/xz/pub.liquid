<article class="pub">
  <div class="ti">{% if include.p.url %}<a href="{{ include.p.url }}">{{ include.p.title }}</a>{% else %}{{ include.p.title }}{% endif %}</div>
  <div class="au">{{ include.p.authors_html }}</div>
  <div class="meta"><i>{{ include.p.where }}</i>{% for l in include.p.links %}<a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}</div>
</article>
