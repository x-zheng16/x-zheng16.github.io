{%- assign n = include.n -%}
<div class="tl">
  {%- unless include.bare %}<div class="d">{{ n.date | date: "%Y.%m" }}</div>{% endunless -%}
  <div class="x">{{ n.content | remove: "<p>" | remove: "</p>" | strip }}{% if n.congrats %} <span class="congrats">{{ n.congrats }}</span>{% endif %}</div>
</div>
