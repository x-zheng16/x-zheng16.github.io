{%- assign n = include.n -%}
<div class="tl">
  {%- if include.month %}{% unless include.same %}<div class="d">{{ n.date | date: "%B" }}</div>{% endunless %}{% else %}<div class="d">{{ n.date | date: "%Y.%m" }}</div>{% endif -%}
  <div class="x">{{ n.content | remove: "<p>" | remove: "</p>" | strip }}{% if n.congrats %} <span class="congrats">{{ n.congrats }}</span>{% endif %}</div>
</div>
