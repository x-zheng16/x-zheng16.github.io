{%- assign t = include.t -%}
{%- assign mm = t.date | slice: 5, 2 | plus: 0 | minus: 1 -%}
{%- assign months = "Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec" | split: "," -%}
<div class="tl">
  {%- if include.month %}<div class="d mon">{{ months[mm] }}</div>{% else %}<div class="d">{{ t.date | slice: 0, 7 | replace: "-", "." }}</div>{% endif -%}
  <div class="x">{{ t.title }}<span class="tag" data-until="{{ t.date }}" hidden>upcoming</span><div class="sub"><span class="spaced"><span>{{ t.venue }}</span><span>{{ t.location }}</span></span></div></div>
</div>
