{%- assign t = include.t -%}
<div class="tl">
  {%- unless include.bare %}<div class="d">{{ t.date | slice: 0, 7 | replace: "-", "." }}</div>{% endunless -%}
  <div class="x">{{ t.title }}<span class="tag" data-until="{{ t.date }}" hidden>upcoming</span><div class="sub"><span class="spaced"><span>{{ t.venue }}</span><span>{{ t.location }}</span></span></div></div>
</div>
